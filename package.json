{
  "name": "taro-rework",
  "version": "0.1.1",
  "packageManager": "pnpm@10.34.7",
  "description": "Typed Taro HTTP client with token refresh, uploads and cancellation",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/rework-union/taro-rework.git" },
  "keywords": ["taro", "request", "typescript", "http", "mini-program"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": { "node": ">=22.12.0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "dev": "pnpm run build --watch",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external @tarojs/taro",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "peerDependencies": {
    "@tarojs/taro": ">=4.0.0 <5"
  },
  "devDependencies": {
    "@tarojs/taro": "^4.3.0",
    "typescript": "^5.9.3",
    "tsup": "^8.5.0",
    "vitest": "^5.0.5"
  }
}
